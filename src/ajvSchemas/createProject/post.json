{
    "type": "object",
    "required": [
      "name",
      "description",
      "owner",
      "status",
      "startDate",
      "endDate"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 2,
        "errorMessage": "Project name must be at least 2 characters long"
      },
      "description": {
        "type": "string",
        "minLength": 5,
        "errorMessage": "Project description must be at least 5 characters long"
      },
      "owner": {
        "type": "string",
        "minLength": 2,
        "errorMessage": "Project owner is required"
      },
      "status": {
        "type": "string",
        "enum": ["INPROGRESS", "DONE", "HOLD"],
        "errorMessage": "Status must be one of INPROGRESS, DONE, HOLD"
      },
      "startDate": {
        "type": "string",
        "format": "date",
        "errorMessage": "Start date must be a valid date (YYYY-MM-DD)"
      },
      "endDate": {
        "type": "string",
        "format": "date",
        "errorMessage": "End date must be a valid date (YYYY-MM-DD)"
      }
    },
    "additionalProperties": false,
    "errorMessage": {
      "required": {
        "name": "Project name is required",
        "description": "Project description is required",
        "owner": "Project owner is required",
        "status": "Project status is required",
        "startDate": "Start date is required",
        "endDate": "End date is required"
      },
      "additionalProperties": "Additional fields are not allowed"
    }
  }
  